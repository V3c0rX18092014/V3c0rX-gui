		korbloxLeg.Anchored = false
		korbloxLeg.CanCollide = false
		korbloxLeg.Color = DARK_GREY_COLOR
		korbloxLeg.Parent = character

		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.FileMesh
		mesh.MeshId = KORBLOX_MESH_ID
		mesh.TextureId = KORBLOX_TEXTURE_ID
		mesh.Scale = Vector3.new(1, 1, 1)
		mesh.Parent = korbloxLeg
	end

	local weld = korbloxLeg:FindFirstChildOfClass("Weld")
	if not weld then
		weld = Instance.new("Weld")
		weld.Part0 = rightUpperLeg
		weld.Part1 = korbloxLeg
		weld.Parent = korbloxLeg
	end
	weld.C0 = CFrame.new(korbloxOffset)
end

local function attachAccessory(acc, char, assetId)
	local handle = acc:FindFirstChild("Handle")
	if not handle then return false end
	handle.CanCollide = false
	handle.Massless = true
	local attachment = handle:FindFirstChildOfClass("Attachment")
	local targetPart = char:FindFirstChild("Head")
	
	if attachment then
		local attachmentName = attachment.Name
		for _, part in ipairs(char:GetChildren()) do
			if part:IsA("BasePart") and part:FindFirstChild(attachmentName) then
				targetPart = part
				break
			end
		end
		local targetAttachment = targetPart:FindFirstChild(attachmentName)
		if targetAttachment then
			handle.CFrame = targetAttachment.WorldCFrame * attachment.CFrame:Inverse()
		else
			handle.CFrame = targetPart.CFrame
		end
	else
		handle.CFrame = targetPart.CFrame
	end
	
	if assetId == 4390891467 then
		handle.CFrame = handle.CFrame * CFrame.new(0, 0, -iceValkOffsetZ)
	end
	
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = targetPart
	weld.Parent = handle
	acc.Parent = char
	return true
end

local function loadAssetWithRetry(assetIdStr, character)
	local assetId = tonumber(assetIdStr)
	local maxAttempts = 2
	local successLoaded = false
	for attempt = 1, maxAttempts do
		local success, err = pcall(function()
			local objects = game:GetObjects("rbxassetid://" .. assetId)
			for _, item in ipairs(objects) do
				if item:IsA("Accessory") then
					if attachAccessory(item, character, assetId) then
						table.insert(equippedItems, {id = tostring(assetId), itemRef = item})
						successLoaded = true
					end
				end
			end
		end)
		if successLoaded then break else task.wait(0.3) end
	end
	return successLoaded
end

