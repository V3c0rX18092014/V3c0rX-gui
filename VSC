		end
	end)

	local function scanAndForceTag(parent)
		for _, obj in ipairs(parent:GetChildren()) do
			if obj:IsA("BillboardGui") then
				obj.Enabled = true
				obj.AlwaysOnTop = true
				for _, child in ipairs(obj:GetDescendants()) do
					if child:IsA("TextLabel") then
						if string.find(child.Text, player.Name) or string.find(child.Text, "VanilBean") or string.find(child.Text, "Creator") then
							child.Text = "VanilBean ✓"
							child.TextColor3 = Color3.fromRGB(160, 80, 255)
						end
					end
					if child:IsA("ImageLabel") then
						child.Visible = true
					end
				end
			end
		end
	end

	scanAndForceTag(head)
	scanAndForceTag(char)
	
	task.spawn(function()
		while char and char.Parent do
			for _, obj in ipairs(char:GetDescendants()) do
				if obj:IsA("BillboardGui") then
					obj.Enabled = true
					obj.AlwaysOnTop = true
					for _, child in ipairs(obj:GetDescendants()) do
						if child:IsA("TextLabel") and (string.find(child.Text, player.Name) or string.find(child.Text, "VanilBean") or string.find(child.Text, "Creator")) then
							if not string.find(child.Text, "✓") then
								child.Text = "VanilBean ✓"
								child.TextColor3 = Color3.fromRGB(160, 80, 255)
							end
						end
					end
				end
			end
			task.wait(0.5)
		end
	end)
end

